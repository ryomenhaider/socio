<% if (ok) { %>
<div class="mt-3 p-4 rounded-xl bg-slate-800 border border-violet-800">
  <div class="flex items-start justify-between gap-4">
    <p class="text-sm text-slate-200 whitespace-pre-wrap leading-relaxed"><%= caption %></p>
    <textarea id="ai-caption-data" class="hidden"><%= caption %></textarea>
    <button type="button"
      onclick="document.getElementById('post-text').value = document.getElementById('ai-caption-data').value; document.getElementById('post-text').dispatchEvent(new Event('input')); this.closest('div').remove();"
      class="shrink-0 text-xs px-3 py-1.5 rounded-lg bg-violet-600 hover:bg-violet-500 text-white transition-colors">
      Use this caption
    </button>
  </div>
</div>
<% } else { %>
<div class="mt-3 p-3 rounded-xl bg-red-950 border border-red-800 text-sm text-red-300"><%= error %></div>
<% } %>
