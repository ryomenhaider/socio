<% if (ok) { %>
<div class="card p-4 border-accent">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <p class="text-sm text-text whitespace-pre-wrap leading-relaxed min-w-0 flex-1"><%= caption %></p>
    <textarea id="ai-caption-data" class="hidden"><%= caption %></textarea>
    <button type="button"
      onclick="document.getElementById('post-text').value = document.getElementById('ai-caption-data').value; document.getElementById('post-text').dispatchEvent(new Event('input')); this.closest('div').remove();"
      class="btn btn-primary btn-sm shrink-0">
      Use this caption
    </button>
  </div>
</div>
<% } else { %>
<div class="alert alert-error"><%= error %></div>
<% } %>
