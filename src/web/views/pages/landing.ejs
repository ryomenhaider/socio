<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Socio · Lightweight social media scheduler</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col">
  <header class="border-b border-slate-800 bg-slate-900/70 backdrop-blur">
    <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between">
      <a href="/" class="font-bold text-lg tracking-tight">
        <span class="text-violet-400">socio</span><span class="text-slate-500">.dev</span>
      </a>
      <a href="/login"
        class="px-4 py-1.5 rounded-lg bg-violet-600 hover:bg-violet-500 text-sm font-medium transition-colors">
        Sign in
      </a>
    </div>
  </header>

  <main class="flex-1 max-w-6xl mx-auto px-4 py-16 w-full">
    <section class="text-center mb-16">
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight mb-4">
        Schedule posts across <span class="text-violet-400">every platform</span>,<br>
        from one tiny server.
      </h1>
      <p class="text-lg text-slate-400 max-w-2xl mx-auto mb-8">
        One tool for LinkedIn, Facebook, Instagram, YouTube and TikTok.
        AI-generated captions, scheduling, retries — and it runs comfortably on a free 1&nbsp;GB instance.
      </p>
      <a href="/login"
        class="px-8 py-3 rounded-xl bg-violet-600 hover:bg-violet-500 font-semibold transition-colors">
        Get started
      </a>
    </section>

    <section class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <div class="rounded-xl bg-slate-900 border border-slate-800 p-5">
        <h2 class="font-semibold mb-1">5 platforms</h2>
        <p class="text-sm text-slate-400">LinkedIn, Facebook, Instagram, YouTube and TikTok — connected once, posted from one place.</p>
      </div>
      <div class="rounded-xl bg-slate-900 border border-slate-800 p-5">
        <h2 class="font-semibold mb-1">AI captions</h2>
        <p class="text-sm text-slate-400">Describe a topic, pick a tone, and get a ready-to-post caption via OpenRouter.</p>
      </div>
      <div class="rounded-xl bg-slate-900 border border-slate-800 p-5">
        <h2 class="font-semibold mb-1">Schedule or now</h2>
        <p class="text-sm text-slate-400">Publish immediately or queue posts; failed targets retry with backoff automatically.</p>
      </div>
      <div class="rounded-xl bg-slate-900 border border-slate-800 p-5">
        <h2 class="font-semibold mb-1">SQLite, no magic</h2>
        <p class="text-sm text-slate-400">Everything lives in one file. Back it up by copying <code class="text-violet-300">data/</code>.</p>
      </div>
      <div class="rounded-xl bg-slate-900 border border-slate-800 p-5">
        <h2 class="font-semibold mb-1">1 GB friendly</h2>
        <p class="text-sm text-slate-400">A single Node.js process with no build step, no Redis, no Kafka.</p>
      </div>
      <div class="rounded-xl bg-slate-900 border border-slate-800 p-5">
        <h2 class="font-semibold mb-1">Private by design</h2>
        <p class="text-sm text-slate-400">Invite-only access. Only users you create can sign in.</p>
      </div>
    </section>
  </main>

  <footer class="border-t border-slate-800 py-4 text-center text-xs text-slate-600">
    socio · <a href="/terms" class="underline hover:text-slate-400">Terms of Service</a> · <a href="/privacy" class="underline hover:text-slate-400">Privacy Policy</a>
  </footer>
</body>
</html>
