<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Socio · Lightweight social media scheduler</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
  <script>
    (function () {
      var saved = null;
      try { saved = localStorage.getItem('socio-theme'); } catch (e) {}
      if (saved === 'dark' || (!saved && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      }
    })();
    window.toggleTheme = function () {
      var el = document.documentElement;
      var dark = el.classList.toggle('dark');
      try { localStorage.setItem('socio-theme', dark ? 'dark' : 'light'); } catch (e) {}
    };
  </script>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            bg: 'rgb(var(--bg) / <alpha-value>)',
            surface: 'rgb(var(--surface) / <alpha-value>)',
            'surface-2': 'rgb(var(--surface-2) / <alpha-value>)',
            input: 'rgb(var(--input) / <alpha-value>)',
            border: 'rgb(var(--border) / <alpha-value>)',
            text: 'rgb(var(--text) / <alpha-value>)',
            muted: 'rgb(var(--muted) / <alpha-value>)',
            faint: 'rgb(var(--faint) / <alpha-value>)',
            accent: 'rgb(var(--accent) / <alpha-value>)',
            'accent-fg': 'rgb(var(--accent-fg) / <alpha-value>)',
            ok: { bg: 'rgb(var(--ok-bg) / <alpha-value>)', fg: 'rgb(var(--ok-fg) / <alpha-value>)' },
            warn: { bg: 'rgb(var(--warn-bg) / <alpha-value>)', fg: 'rgb(var(--warn-fg) / <alpha-value>)' },
            err: { bg: 'rgb(var(--err-bg) / <alpha-value>)', fg: 'rgb(var(--err-fg) / <alpha-value>)' },
            info: { bg: 'rgb(var(--info-bg) / <alpha-value>)', fg: 'rgb(var(--info-fg) / <alpha-value>)' }
          }
        }
      }
    };
  </script>
  <link rel="stylesheet" href="/theme.css">
</head>
<body class="bg-bg text-text min-h-screen flex flex-col">
  <header class="border-b border-border bg-bg/80 backdrop-blur">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-4 flex items-center justify-between gap-3">
      <a href="/" class="font-display font-bold text-xl tracking-tight">socio</a>
      <div class="flex items-center gap-2.5">
        <button type="button" onclick="toggleTheme()" aria-label="Toggle dark mode" title="Toggle dark mode" class="icon-btn">
          <svg class="theme-icon-sun w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="4"/>
            <path stroke-linecap="round" d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4"/>
          </svg>
          <svg class="theme-icon-moon w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/>
          </svg>
        </button>
        <a href="/login" class="btn btn-ghost">Sign in</a>
        <a href="/login" class="btn btn-primary hidden sm:inline-flex">Get started</a>
      </div>
    </div>
  </header>

  <main class="flex-1 w-full">
    <section class="hero-grid border-b border-border">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 py-24 lg:py-32 text-center">
        <p class="micro mb-6">Self-hosted · SQLite · runs on 1 GB</p>
        <h1 class="font-display text-5xl sm:text-6xl font-bold tracking-tight leading-[1.05] max-w-3xl mx-auto">
          Schedule posts across <span class="underline decoration-2 underline-offset-8">every platform</span> from one tiny server.
        </h1>
        <p class="mt-7 text-lg text-muted max-w-2xl mx-auto leading-relaxed">
          LinkedIn, Facebook, Instagram, YouTube and TikTok. AI-generated captions, scheduling with retries — no build step, no Redis, no Kafka.
        </p>
        <div class="mt-10 flex flex-wrap justify-center gap-3">
          <a href="/login" class="btn btn-primary btn-lg">Get started</a>
          <a href="/login" class="btn btn-ghost btn-lg">Sign in</a>
        </div>
        <div class="mt-20 grid grid-cols-1 sm:grid-cols-3 gap-10 max-w-3xl mx-auto">
          <div>
            <p class="font-display text-4xl font-semibold tracking-tight">5</p>
            <p class="micro mt-1.5">Platforms</p>
          </div>
          <div>
            <p class="font-display text-4xl font-semibold tracking-tight">1</p>
            <p class="micro mt-1.5">SQLite file</p>
          </div>
          <div>
            <p class="font-display text-4xl font-semibold tracking-tight">30s</p>
            <p class="micro mt-1.5">Retry backoff</p>
          </div>
        </div>
      </div>
    </section>

    <section class="max-w-6xl mx-auto px-4 sm:px-6 py-16 lg:py-20">
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-px bg-border border border-border rounded-lg overflow-hidden">
        <div class="bg-bg p-6 lg:p-7">
          <p class="micro">01</p>
          <h2 class="font-display font-semibold text-lg tracking-tight mt-4 mb-2">Five platforms</h2>
          <p class="text-sm text-muted leading-relaxed">LinkedIn, Facebook, Instagram, YouTube and TikTok — connected once, posted from one place.</p>
        </div>
        <div class="bg-bg p-6 lg:p-7">
          <p class="micro">02</p>
          <h2 class="font-display font-semibold text-lg tracking-tight mt-4 mb-2">AI captions</h2>
          <p class="text-sm text-muted leading-relaxed">Describe a topic, pick a tone, get a ready-to-post caption via OpenRouter.</p>
        </div>
        <div class="bg-bg p-6 lg:p-7">
          <p class="micro">03</p>
          <h2 class="font-display font-semibold text-lg tracking-tight mt-4 mb-2">Schedule or now</h2>
          <p class="text-sm text-muted leading-relaxed">Publish immediately or queue posts; failed targets retry with backoff automatically.</p>
        </div>
        <div class="bg-bg p-6 lg:p-7">
          <p class="micro">04</p>
          <h2 class="font-display font-semibold text-lg tracking-tight mt-4 mb-2">SQLite, no magic</h2>
          <p class="text-sm text-muted leading-relaxed">Everything lives in one file. Back it up by copying <code class="font-mono text-text">data/</code>.</p>
        </div>
        <div class="bg-bg p-6 lg:p-7">
          <p class="micro">05</p>
          <h2 class="font-display font-semibold text-lg tracking-tight mt-4 mb-2">1 GB friendly</h2>
          <p class="text-sm text-muted leading-relaxed">A single Node.js process with no build step, no Redis, no Kafka.</p>
        </div>
        <div class="bg-bg p-6 lg:p-7">
          <p class="micro">06</p>
          <h2 class="font-display font-semibold text-lg tracking-tight mt-4 mb-2">Private by design</h2>
          <p class="text-sm text-muted leading-relaxed">Invite-only access. Only users you create can sign in.</p>
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t border-border py-6 text-center text-xs text-faint">
    socio · <a href="/terms" class="underline hover:text-text">Terms of Service</a> · <a href="/privacy" class="underline hover:text-text">Privacy Policy</a>
  </footer>
</body>
</html>
