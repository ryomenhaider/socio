<%- include('../partials/head') %>
<%- include('../partials/header') %>

<div class="flex flex-wrap items-end justify-between gap-3 mb-10">
  <div>
    <p class="micro mb-1.5">Overview</p>
    <h1 class="font-display text-3xl font-bold tracking-tight">Dashboard</h1>
  </div>
  <p class="text-xs text-faint font-mono"><%= new Date().toDateString() %></p>
</div>

<div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-10">
  <div class="card p-5">
    <p class="micro">Drafts</p>
    <p class="font-display text-4xl font-semibold tracking-tight mt-2.5"><%= stats.drafts %></p>
  </div>
  <div class="card p-5">
    <p class="micro">Scheduled</p>
    <p class="font-display text-4xl font-semibold tracking-tight mt-2.5 text-info-fg"><%= stats.scheduled %></p>
  </div>
  <div class="card p-5">
    <p class="micro">Published</p>
    <p class="font-display text-4xl font-semibold tracking-tight mt-2.5 text-ok-fg"><%= stats.published %></p>
  </div>
  <div class="card p-5">
    <p class="micro">Failed</p>
    <p class="font-display text-4xl font-semibold tracking-tight mt-2.5 text-err-fg"><%= stats.failed %></p>
  </div>
</div>

<div class="grid lg:grid-cols-2 gap-6 mb-10">
  <section>
    <div class="flex items-baseline justify-between mb-3">
      <h2 class="font-display text-lg font-semibold tracking-tight">Connected accounts</h2>
      <a href="/accounts" class="link text-sm">Manage</a>
    </div>
    <% if (accounts.length === 0) { %>
      <div class="card p-5">
        <p class="text-sm text-muted">No accounts connected yet. <a href="/accounts" class="link">Connect LinkedIn</a> to start posting.</p>
      </div>
    <% } else { %>
      <ul class="card divide-y divide-border">
        <% for (const a of accounts) { %>
          <li class="flex items-center justify-between gap-3 px-5 py-3.5">
            <div class="min-w-0">
              <p class="font-medium capitalize"><%= a.platform %></p>
              <p class="text-sm text-muted truncate"><%= a.display_name %></p>
            </div>
            <span class="chip"><span class="dot <%= a.status === 'connected' ? 'bg-ok-fg' : 'bg-err-fg' %>"></span><%= a.status %></span>
          </li>
        <% } %>
      </ul>
    <% } %>
  </section>

  <section>
    <div class="flex items-baseline justify-between mb-3">
      <h2 class="font-display text-lg font-semibold tracking-tight">Upcoming</h2>
      <a href="/posts" class="link text-sm">All posts</a>
    </div>
    <% if (upcoming.length === 0) { %>
      <div class="card p-5">
        <p class="text-sm text-muted">Nothing scheduled.</p>
      </div>
    <% } else { %>
      <ul class="card divide-y divide-border">
        <% for (const t of upcoming) { %>
          <li class="flex items-center justify-between gap-3 px-5 py-3.5">
            <div class="min-w-0">
              <p class="text-sm font-medium capitalize truncate"><%= t.account_platform %> → <%= t.account_name %></p>
              <p class="text-xs text-faint">Post #<%= t.post_id %></p>
            </div>
            <span class="text-xs text-faint font-mono shrink-0"><%= t.scheduled_at.replace('T', ' ').slice(0, 16) %> UTC</span>
          </li>
        <% } %>
      </ul>
    <% } %>
  </section>
</div>

<section>
  <div class="flex items-baseline justify-between mb-3">
    <h2 class="font-display text-lg font-semibold tracking-tight">Recent posts</h2>
    <a href="/compose" class="link text-sm">Compose</a>
  </div>
  <% if (recent.length === 0) { %>
    <div class="card p-5">
      <p class="text-sm text-muted">No posts yet. <a href="/compose" class="link">Write your first post</a>.</p>
    </div>
  <% } else { %>
    <ul class="card divide-y divide-border">
      <% for (const p of recent) { %>
        <li class="flex items-center justify-between gap-4 px-5 py-3.5">
          <p class="text-sm text-muted truncate"><%= p.text.length > 120 ? p.text.slice(0, 120) + '…' : p.text %></p>
          <span class="text-xs text-faint shrink-0">
            <%= p.target_count %> target<%= p.target_count === 1 ? '' : 's' %> · <span class="font-mono"><%= p.created_at.slice(0, 16) %> UTC</span>
          </span>
        </li>
      <% } %>
    </ul>
  <% } %>
</section>

<%- include('../partials/foot') %>
