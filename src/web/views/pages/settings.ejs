<%- include('../partials/head') %>
<%- include('../partials/header') %>

<div class="mb-10">
  <p class="micro mb-1.5">Preferences</p>
  <h1 class="font-display text-3xl font-bold tracking-tight">Settings</h1>
</div>

<% if (msg === 'saved') { %>
  <div class="alert alert-ok mb-6">Settings saved.</div>
<% } %>

<form method="post" action="/settings" class="card p-6 max-w-xl space-y-6">
  <div>
    <label for="openrouter_api_key" class="label">OpenRouter API key</label>
    <input id="openrouter_api_key" name="openrouter_api_key" type="password" value="<%= key %>" autocomplete="off"
      placeholder="sk-or-v1-…" class="input">
    <p class="text-xs text-faint mt-2">Get one free at <span class="font-mono text-muted">openrouter.ai/keys</span>. Used for AI captions.</p>
  </div>
  <div>
    <label for="openrouter_model" class="label">AI model</label>
    <input id="openrouter_model" name="openrouter_model" type="text" value="<%= model %>" class="input">
    <p class="text-xs text-faint mt-2">Any OpenRouter model id, e.g. <span class="font-mono text-muted">openai/gpt-4o-mini</span> or <span class="font-mono text-muted">meta-llama/llama-3.3-70b-instruct</span>.</p>
  </div>
  <div class="pt-2">
    <button class="btn btn-primary">Save</button>
  </div>
</form>

<%- include('../partials/foot') %>
