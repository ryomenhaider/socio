<%- include('../partials/head') %>
<%- include('../partials/header') %>

<div class="flex flex-wrap items-end justify-between gap-3 mb-10">
  <div>
    <p class="micro mb-1.5">Library</p>
    <h1 class="font-display text-3xl font-bold tracking-tight">Posts</h1>
  </div>
  <a href="/compose" class="btn btn-primary">New post</a>
</div>

<% if (msg) { %>
  <div class="alert <%= msg.ok ? 'alert-ok' : 'alert-error' %> mb-6"><%= msg.text %></div>
<% } %>

<% if (posts.length === 0) { %>
  <div class="card p-5">
    <p class="text-sm text-muted">No posts yet. <a href="/compose" class="link">Compose your first one</a>.</p>
  </div>
<% } else { %>
  <div class="space-y-4">
    <% for (const p of posts) { %>
      <article class="card p-6">
        <div class="flex flex-wrap items-start justify-between gap-3 mb-4">
          <div class="min-w-0 flex-1">
            <p class="text-[15px] leading-relaxed whitespace-pre-wrap break-words"><%= p.text %></p>
            <% if (p.mediaUrl) { %>
              <div class="mt-4">
                <% if (p.media_type === 'video') { %>
                  <video src="<%= p.mediaUrl %>" controls class="max-h-56 w-full max-w-full rounded-lg border border-border bg-surface-2"></video>
                <% } else { %>
                  <img src="<%= p.mediaUrl %>" alt="" class="max-h-56 max-w-full rounded-lg border border-border bg-surface-2">
                <% } %>
              </div>
            <% } %>
          </div>
          <p class="text-xs text-faint font-mono shrink-0">Created <%= p.created_at.slice(0, 16) %> UTC</p>
        </div>
        <% const targets = targetsByPost.get(p.id) || []; %>
        <div class="flex flex-wrap gap-2">
          <% for (const t of targets) { %>
            <span class="chip">
              <span class="capitalize"><%= t.account_platform %></span>
              <span class="text-faint">→</span>
              <span class="text-muted"><%= t.account_name %></span>
              <span class="dot
                <%= t.status === 'published' ? 'bg-ok-fg' : '' %><%= t.status === 'scheduled' ? 'bg-info-fg' : '' %><%= t.status === 'publishing' ? 'bg-warn-fg' : '' %><%= t.status === 'failed' ? 'bg-err-fg' : '' %>"></span>
              <span class="<%= t.status === 'failed' ? 'text-err-fg font-semibold' : '' %>"><%= t.status %></span>
              <% if (t.status === 'failed') { %>
                <form method="post" action="/targets/<%= t.id %>/retry" class="inline">
                  <button class="link">retry</button>
                </form>
              <% } %>
            </span>
          <% } %>
        </div>
        <% if (targets.some(t => t.error)) { %>
          <p class="mt-3 text-xs text-err-fg leading-relaxed">
            <%= targets.filter(t => t.error).map(t => `${t.account_platform}: ${t.error}`).join(' · ') %>
          </p>
        <% } %>
      </article>
    <% } %>
  </div>
<% } %>

<%- include('../partials/foot') %>
