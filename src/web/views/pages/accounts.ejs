<%- include('../partials/head') %>
<%- include('../partials/header') %>

<div class="mb-10">
  <p class="micro mb-1.5">Integrations</p>
  <h1 class="font-display text-3xl font-bold tracking-tight">Accounts</h1>
</div>

<% const MSG = {
  connected: { ok: true, text: 'Account(s) connected.' },
  updated: { ok: true, text: 'Existing account tokens refreshed.' },
  disconnected: { ok: true, text: 'Account disconnected.' },
  refreshed: { ok: true, text: 'Token refreshed.' },
  denied: { ok: false, text: 'Authorization was cancelled or denied.' },
  error: { ok: false, text: 'Something went wrong during authorization. Check server logs.' },
  bad_state: { ok: false, text: 'Invalid OAuth state. Try again.' },
  not_available: { ok: false, text: 'That platform is not available yet.' }
}; %>
<% if (msg && MSG[msg]) { %>
  <div class="alert <%= MSG[msg].ok ? 'alert-ok' : 'alert-error' %> mb-6">
    <%= MSG[msg].text %><% if (desc) { %><br><code class="text-xs"><%= desc %></code><% } %>
  </div>
<% } %>

<div class="grid md:grid-cols-2 xl:grid-cols-3 gap-4 mb-12">
  <% for (const p of Object.values(platforms)) { %>
    <div class="card p-6 flex flex-col">
      <div class="flex items-center justify-between mb-4">
        <h2 class="font-display font-semibold text-lg tracking-tight capitalize"><%= p.label %></h2>
        <% if (p.available) { %>
          <span class="chip"><span class="dot bg-ok-fg"></span>ready</span>
        <% } else { %>
          <span class="chip">soon</span>
        <% } %>
      </div>
      <% if (p.available) { %>
        <% if (p.id === 'facebook' || p.id === 'instagram') { %>
          <p class="text-xs text-muted leading-relaxed">
            Imported when you <a href="/auth/meta" class="link">connect Meta</a>.
          </p>
        <% } else { %>
          <a href="/auth/<%= p.id %>" class="btn btn-primary self-start">
            Connect <%= p.label %>
          </a>
        <% } %>
        <% if (p.connectNote) { %>
          <p class="text-xs text-faint leading-relaxed mt-3"><%= p.connectNote %></p>
        <% } %>
      <% } else { %>
        <p class="text-xs text-faint leading-relaxed"><%= p.connectNote %></p>
      <% } %>
    </div>
  <% } %>
</div>

<h2 class="font-display text-lg font-semibold tracking-tight mb-4">Your accounts</h2>
<% if (accounts.length === 0) { %>
  <div class="card p-5">
    <p class="text-sm text-muted">No accounts connected yet.</p>
  </div>
<% } else { %>
  <div class="card divide-y divide-border">
    <% for (const a of accounts) { %>
      <div class="px-6 py-5">
        <div class="flex flex-wrap items-center justify-between gap-4">
          <div class="min-w-0">
            <p class="font-medium capitalize"><%= a.platform %> · <%= a.display_name %></p>
            <p class="text-xs text-faint mt-0.5">Connected <span class="font-mono"><%= a.created_at.slice(0, 16) %> UTC</span></p>
            <% if (a.expires_at) { %>
              <p class="text-xs mt-0.5 <%= a.expires_at < Date.now() ? 'text-err-fg' : 'text-faint' %>">
                Token expires <span class="font-mono"><%= new Date(a.expires_at).toISOString().slice(0, 16) %> UTC</span>
                <% if (a.expires_at < Date.now() && a.has_refresh) { %>— use "Refresh token"<% } %>
                <% if (a.expires_at < Date.now() && !a.has_refresh) { %>— re-connect the account<% } %>
              </p>
            <% } %>
            <% if (a.last_error) { %>
              <p class="text-xs text-err-fg mt-1"><%= a.last_error %></p>
            <% } %>
          </div>
          <div class="flex flex-wrap gap-2">
            <% if (a.has_refresh) { %>
              <form method="post" action="/accounts/<%= a.id %>/refresh">
                <button class="btn btn-ghost btn-sm">Refresh token</button>
              </form>
            <% } %>
            <% if (a.platform === 'tiktok') { %>
              <a href="/auth/tiktok" class="btn btn-ghost btn-sm">Re-connect</a>
            <% } %>
            <form method="post" action="/accounts/<%= a.id %>/disconnect"
              onsubmit="return confirm('Disconnect this account? Scheduled posts to it will be removed.')">
              <button class="btn btn-danger btn-sm">Disconnect</button>
            </form>
          </div>
        </div>
      </div>
    <% } %>
  </div>
<% } %>

<%- include('../partials/foot') %>
