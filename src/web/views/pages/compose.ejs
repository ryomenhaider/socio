<%- include('../partials/head') %>
<%- include('../partials/header') %>

<div class="mb-10">
  <p class="micro mb-1.5">Create</p>
  <h1 class="font-display text-3xl font-bold tracking-tight">Compose post</h1>
</div>

<% const MSG = {
  no_platform: 'Select at least one platform to post to.',
  empty: 'Write some text or use the AI copywriter.',
  error: 'Something went wrong. Try again.',
  no_consent: 'TikTok requires your consent to post — check the music usage confirmation box.',
  no_privacy: 'TikTok requires a privacy level — pick one from the dropdown.',
  bad_file: 'Rejected file — content did not match its declared type.'
}; %>
<% if (msg) { %>
  <div class="alert alert-error mb-6 <%= MSG[msg] ? '' : 'hidden' %>"><%= MSG[msg] || msg %></div>
<% } %>

<form action="/compose" method="post" enctype="multipart/form-data" x-data="{ mode: 'now' }" class="max-w-3xl space-y-6">

  <div class="card p-6">
    <div class="flex flex-wrap items-center gap-2.5 mb-4">
      <h2 class="font-display font-semibold text-lg tracking-tight">AI copywriter</h2>
      <% if (!aiConfigured) { %>
        <span class="chip"><span class="dot bg-warn-fg"></span>add OPENROUTER_API_KEY in .env</span>
      <% } %>
    </div>
    <div class="grid sm:grid-cols-3 gap-4">
      <div class="sm:col-span-3">
        <label for="ai-topic" class="label">Topic or keywords</label>
        <input id="ai-topic" name="topic" type="text" placeholder="e.g. launch of our new analytics dashboard" class="input">
      </div>
      <div>
        <label for="ai-tone" class="label">Tone</label>
        <select id="ai-tone" name="tone" class="input">
          <option value="professional">Professional</option>
          <option value="casual">Casual</option>
          <option value="funny">Funny</option>
          <option value="enthusiastic">Enthusiastic</option>
          <option value="empathetic">Empathetic</option>
        </select>
      </div>
      <div>
        <label for="ai-length" class="label">Length</label>
        <select id="ai-length" name="length" class="input">
          <option value="medium">Medium</option>
          <option value="short">Short</option>
          <option value="long">Long</option>
        </select>
      </div>
      <div>
        <label for="ai-model" class="label">AI model</label>
        <select id="ai-model" name="model" class="input">
          <% for (const m of aiModels) { %>
            <option value="<%= m.id %>" <%= m.id === aiModel ? 'selected' : '' %>><%= m.label %></option>
          <% } %>
        </select>
      </div>
      <div class="sm:col-span-2">
        <label class="label">Platforms</label>
        <div id="ai-platforms" class="flex flex-wrap gap-x-5 gap-y-2">
          <% for (const p of aiPlatforms) { %>
            <label class="flex items-center gap-2 text-sm text-muted cursor-pointer">
              <input type="checkbox" name="platforms" value="<%= p.id %>" class="w-4 h-4 accent-accent">
              <%= p.label %>
            </label>
          <% } %>
        </div>
      </div>
      <div class="flex items-end">
        <button type="button" hx-post="/api/copy" hx-include="#ai-topic,#ai-tone,#ai-length,#ai-model,#ai-platforms" hx-target="#copy-result" hx-swap="innerHTML"
          class="btn btn-ghost w-full" <%= aiConfigured ? '' : 'disabled' %>>
          Generate copy
        </button>
      </div>
    </div>
    <p class="text-xs text-faint mt-3 leading-relaxed">
      One prompt, one tailored piece per platform — LinkedIn post, YouTube title + description, TikTok caption, and more.
    </p>
    <div id="copy-result" class="mt-4"></div>
  </div>

  <div class="card p-6">
    <h2 class="font-display font-semibold text-lg tracking-tight mb-4">Post to</h2>
    <% if (accounts.length === 0) { %>
      <p class="text-sm text-muted">No connected accounts. <a href="/accounts" class="link">Connect one first</a>.</p>
    <% } else { %>
      <% const MEDIA_HINTS = {
        linkedin: 'Image recommended (1200×627). A text-only post works too.',
        facebook: 'Image or video.',
        instagram: 'Image or video (1080×1080 square or 4:5). Instagram requires media.',
        youtube: 'Video file (mp4). YouTube requires a video.',
        tiktok: 'Video file (mp4). TikTok requires a video.'
      }; %>
      <div class="card divide-y divide-border">
        <% for (const a of accounts) { %>
          <div>
            <label class="flex items-center gap-3.5 px-4 py-3 cursor-pointer transition-colors hover:bg-surface-2">
              <input type="checkbox" name="platforms" value="<%= a.id %>" class="w-4 h-4 accent-accent"
                onchange="document.getElementById('account-panel-<%= a.id %>').classList.toggle('hidden', !this.checked)"
                <% if (a.platform === 'tiktok') { %>
                  hx-get="/api/tiktok/options?account_id=<%= a.id %>" hx-trigger="change" hx-target="#tiktok-panel-<%= a.id %>" hx-swap="innerHTML"
                <% } %>
              >
              <span class="capitalize font-medium text-sm w-24"><%= a.platform %></span>
              <span class="text-sm text-muted truncate"><%= a.display_name %></span>
            </label>
            <div id="account-panel-<%= a.id %>" class="hidden px-4 pb-5 pt-1 space-y-4">
              <div>
                <label for="text-<%= a.id %>" class="label">Text for <%= a.platform %></label>
                <textarea id="text-<%= a.id %>" name="text_<%= a.id %>" data-platform="<%= a.platform %>" rows="3" maxlength="3000"
                  placeholder="Leave empty to use the shared post text"
                  class="input leading-relaxed"></textarea>
                <p class="text-xs text-faint mt-2">Leave empty to use the shared "Post text" above.</p>
              </div>
              <div>
                <label class="label">Media <span class="font-normal text-faint">(optional)</span></label>
                <input type="file" name="media_<%= a.id %>" accept="image/*,video/*"
                  class="block w-full text-sm text-faint file:mr-4 file:py-2 file:px-4 file:rounded-md file:border file:border-border file:bg-surface-2 file:text-text hover:file:bg-input">
                <p class="text-xs text-faint mt-2"><%= MEDIA_HINTS[a.platform] || 'Image or video.' %></p>
              </div>
              <% if (a.platform === 'youtube') { %>
                <div class="grid sm:grid-cols-2 gap-4">
                  <div>
                    <label class="label">Video title</label>
                    <input name="youtube_title_<%= a.id %>" data-platform="youtube" data-role="title" type="text" maxlength="100"
                      placeholder="Leave empty to use the text" class="input">
                  </div>
                  <div>
                    <label class="label">Visibility</label>
                    <select name="youtube_privacy_<%= a.id %>" class="input">
                      <option value="public">Public</option>
                      <option value="unlisted">Unlisted</option>
                      <option value="private">Private</option>
                    </select>
                  </div>
                </div>
              <% } %>
              <% if (a.platform === 'tiktok') { %>
                <div id="tiktok-panel-<%= a.id %>"></div>
              <% } %>
            </div>
          </div>
        <% } %>
      </div>
      <p class="text-xs text-faint mt-3 leading-relaxed">
        Per-platform fields are optional — anything left empty falls back to the shared post text/media above.
        Instagram needs a business account and requires media. YouTube and TikTok need a video file.
        TikTok videos can take a few minutes to appear after posting.
      </p>
    <% } %>
  </div>

  <div class="card p-6">
    <h2 class="font-display font-semibold text-lg tracking-tight mb-4">When</h2>
    <div class="flex flex-wrap items-center gap-6">
      <label class="flex items-center gap-2.5 text-sm cursor-pointer">
        <input type="radio" name="publish_mode" value="now" x-model="mode" class="accent-accent">
        Publish now
      </label>
      <label class="flex items-center gap-2.5 text-sm cursor-pointer">
        <input type="radio" name="publish_mode" value="schedule" x-model="mode" class="accent-accent">
        Schedule
      </label>
      <div x-show="mode === 'schedule'" x-cloak class="w-full sm:w-auto">
        <input type="datetime-local" id="scheduled-at" onchange="document.getElementById('scheduled-at-iso').value = new Date(this.value).toISOString()"
          class="input sm:w-64">
        <input type="hidden" name="scheduled_at" id="scheduled-at-iso">
      </div>
    </div>
  </div>

  <div class="flex flex-wrap items-center gap-3 pt-2">
    <button type="submit" <%= accounts.length === 0 ? 'disabled' : '' %> class="btn btn-primary">
      Post it
    </button>
    <% if (accounts.length === 0) { %>
      <span class="text-xs text-faint">Connect an account before posting.</span>
    <% } %>
  </div>
</form>

<script>
  const aiCopyData = (btn) => btn.closest('.card').querySelector('.ai-copy-data').value;
  const copyAiCopy = (btn) => {
    const text = aiCopyData(btn);
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text);
    } else {
      const ta = document.createElement('textarea');
      ta.value = text;
      document.body.appendChild(ta);
      ta.select();
      document.execCommand('copy');
      ta.remove();
    }
    btn.textContent = 'Copied';
    setTimeout(() => { btn.textContent = 'Copy'; }, 1500);
  };
  const useAiCopy = (btn) => {
    const postText = document.getElementById('post-text');
    postText.value = aiCopyData(btn);
    postText.dispatchEvent(new Event('input'));
    btn.closest('.card').remove();
  };
</script>

<script>
  const postText = document.getElementById('post-text');
  const postTextCount = document.getElementById('post-text-count');
  const updateCount = () => {
    const n = postText.value.length;
    postTextCount.textContent = n + ' / 3000';
    postTextCount.classList.toggle('text-err-fg', n > 3000);
    postTextCount.classList.toggle('text-faint', n <= 3000);
  };
  postText.addEventListener('input', updateCount);
  updateCount();
</script>

<%- include('../partials/foot') %>
