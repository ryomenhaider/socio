<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Sign in · Socio</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
  <script>
    (function () {
      var saved = null;
      try { saved = localStorage.getItem('socio-theme'); } catch (e) {}
      if (saved === 'dark' || (!saved && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      }
    })();
    window.toggleTheme = function () {
      var el = document.documentElement;
      var dark = el.classList.toggle('dark');
      try { localStorage.setItem('socio-theme', dark ? 'dark' : 'light'); } catch (e) {}
    };
  </script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            bg: 'rgb(var(--bg) / <alpha-value>)',
            surface: 'rgb(var(--surface) / <alpha-value>)',
            'surface-2': 'rgb(var(--surface-2) / <alpha-value>)',
            input: 'rgb(var(--input) / <alpha-value>)',
            border: 'rgb(var(--border) / <alpha-value>)',
            text: 'rgb(var(--text) / <alpha-value>)',
            muted: 'rgb(var(--muted) / <alpha-value>)',
            faint: 'rgb(var(--faint) / <alpha-value>)',
            accent: 'rgb(var(--accent) / <alpha-value>)',
            'accent-fg': 'rgb(var(--accent-fg) / <alpha-value>)',
            ok: { bg: 'rgb(var(--ok-bg) / <alpha-value>)', fg: 'rgb(var(--ok-fg) / <alpha-value>)' },
            warn: { bg: 'rgb(var(--warn-bg) / <alpha-value>)', fg: 'rgb(var(--warn-fg) / <alpha-value>)' },
            err: { bg: 'rgb(var(--err-bg) / <alpha-value>)', fg: 'rgb(var(--err-fg) / <alpha-value>)' },
            info: { bg: 'rgb(var(--info-bg) / <alpha-value>)', fg: 'rgb(var(--info-fg) / <alpha-value>)' }
          }
        }
      }
    };
  </script>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/theme.css">
</head>
<body class="bg-bg text-text min-h-screen flex flex-col">
  <header class="border-b border-border bg-bg/80 backdrop-blur">
    <div class="max-w-3xl mx-auto px-4 py-4 flex items-center justify-between gap-3">
      <a href="/" class="font-display font-bold text-xl tracking-tight">socio<span class="text-faint">.dev</span></a>
      <div class="flex items-center gap-2.5">
        <button type="button" onclick="toggleTheme()" aria-label="Toggle dark mode" title="Toggle dark mode" class="icon-btn">
          <svg class="theme-icon-sun w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="4"/>
            <path stroke-linecap="round" d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4"/>
          </svg>
          <svg class="theme-icon-moon w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/>
          </svg>
        </button>
        <a href="/" class="btn btn-ghost btn-sm">Back</a>
      </div>
    </div>
  </header>

  <main class="flex-1 flex items-center justify-center px-4 py-16">
    <div class="w-full max-w-sm">
      <div class="text-center mb-8">
        <a href="/" class="font-display font-bold text-3xl tracking-tight">socio<span class="text-faint">.dev</span></a>
        <p class="micro mt-3">Sign in to your scheduler</p>
      </div>
      <% if (msg === 'bad_credentials') { %>
        <div class="alert alert-error mb-5">Wrong username or password. Try again.</div>
      <% } %>
      <form method="post" action="/login<%= next && next !== '/dashboard' ? '?next=' + encodeURIComponent(next) : '' %>"
        class="card p-6 space-y-5">
        <div>
          <label for="username" class="label">Username</label>
          <input id="username" name="username" type="text" required autofocus autocomplete="username" class="input">
        </div>
        <div>
          <label for="password" class="label">Password</label>
          <input id="password" name="password" type="password" required autocomplete="current-password" class="input">
        </div>
        <button type="submit" class="btn btn-primary btn-block">Sign in</button>
      </form>
      <p class="text-center text-xs text-faint mt-6">
        This is a private tool. <a href="/terms" class="link">Terms</a> · <a href="/privacy" class="link">Privacy</a>
      </p>
    </div>
  </main>

  <footer class="border-t border-border py-5 text-center text-xs text-faint">
    socio · lightweight scheduler · SQLite · runs on 1 GB RAM
  </footer>
</body>
</html>
