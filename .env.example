# Socio server configuration. Copy to .env and fill in.

# Public URL of this instance. Must match the redirect URI registered in your
# LinkedIn developer app: {BASE_URL}/auth/linkedin/callback
BASE_URL=http://localhost:3000

# HTTP port
PORT=3000

# Data directory (SQLite db + uploaded media live here)
DATA_DIR=./data

# --- OpenRouter (AI captions) ---
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Any model OpenRouter supports; gpt-4o-mini is a good cheap default
OPENROUTER_MODEL=openai/gpt-4o-mini

# --- LinkedIn ---
# Create an app at https://www.linkedin.com/developers/apps
# Add the "Share on LinkedIn" product (grants w_member_social scope).
# OAuth redirect URI must be: {BASE_URL}/auth/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- Meta (Facebook + Instagram) ---
# One app at https://developers.facebook.com/apps covers both.
# Products: "Facebook Login for Business" + "Instagram Graph API".
# OAuth redirect URI must be: {BASE_URL}/auth/meta/callback
# Note: you must be an admin of the Facebook page(s); Instagram must be
# a business/creator account linked to the page.
META_CLIENT_ID=
META_CLIENT_SECRET=

# --- YouTube ---
# Google Cloud project with "YouTube Data API v3" enabled.
# OAuth consent screen (external) with redirect URI {BASE_URL}/auth/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- TikTok ---
# App at https://developers.tiktok.com with "Content Posting API" + Direct Post.
# Redirect URI must be HTTPS (no query params): {BASE_URL}/auth/tiktok/callback
# IMPORTANT: until your app passes TikTok's audit, posts are restricted to
# private view (SELF_ONLY) with a small active-user cap.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
